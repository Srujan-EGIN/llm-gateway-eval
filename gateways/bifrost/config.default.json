{
  "auth_config": {
    "is_enabled": true,
    "admin_username": "admin",
    "admin_password": "${BIFROST_ADMIN_PASSWORD}"
  },
  "client": {
    "enable_logging": true,
    "disable_content_logging": false,
    "enforce_auth_on_inference": true,
    "allow_direct_keys": false
  },
  "providers": {
    "openai": {
      "keys": [
        {
          "name": "mock",
          "value": "fake-key",
          "models": [
            "*"
          ],
          "weight": 1
        }
      ],
      "network_config": {
        "base_url": "${MOCK_URL}",
        "allow_private_network": true,
        "max_retries": 0
      }
    }
  },
  "governance": {
    "virtual_keys": [
      {
        "id": "vk-app",
        "name": "app",
        "value": "${BIFROST_APP_KEY}",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "openai",
            "allowed_models": [
              "*"
            ],
            "weight": 1,
            "key_ids": [
              "*"
            ]
          }
        ]
      },
      {
        "id": "vk-limited",
        "name": "eu-mode",
        "value": "${BIFROST_LIMITED_KEY}",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "openai",
            "allowed_models": [
              "fast-model"
            ],
            "weight": 1,
            "key_ids": [
              "*"
            ]
          }
        ]
      }
    ],
    "routing_rules": [
      {
        "id": "eu-chat",
        "name": "eu-chat",
        "enabled": true,
        "cel_expression": "model == 'eu-chat'",
        "scope": "global",
        "priority": 0,
        "targets": [
          {
            "provider": "openai",
            "model": "broken-model",
            "weight": 1
          }
        ],
        "fallbacks": [
          "openai/backup-model"
        ]
      }
    ]
  },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/config.db"
    }
  },
  "logs_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/logs.db"
    }
  }
}
